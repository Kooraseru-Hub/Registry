{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Registry: Benchmark and Build",
      "detail": "Run the Studio benchmark and build the README with its heatmaps.",
      "type": "process",
      "command": "bash",
      "windows": {
        "command": "C:/msys64/usr/bin/bash.exe"
      },
      "args": [
        "tests/registry/Studio/benchmark-build.sh"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "Registry: Verify in Studio",
      "detail": "Run the Registry API smoke test on Windows.",
      "type": "process",
      "command": "bash",
      "windows": {
        "command": "C:/msys64/usr/bin/bash.exe"
      },
      "args": [
        "tests/registry/Studio/run.sh",
        "Lookup"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Registry: Emulate GitHub Actions",
      "detail": "Run the workflow with act and retain the artifact ZIP.",
      "type": "process",
      "command": "act",
      "args": [
        "-W",
        ".github/workflows/ci.yml",
        "push"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}
